<?xml version="1.0" encoding="utf-8"?>
<!-- Velik widget s priljubljenimi vnosi: tap na gumb takoj zapiše vnos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/fav_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill_24"
        android:tint="@color/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fav_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/fav_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_favorites_title"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fav_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/widget_favorites_hint"
                    android:textColor="@color/widget_subtext"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Razveljavi zadnji vnos (vidno 60 s po tapu) -->
            <FrameLayout
                android:id="@+id/fav_undo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/fav_undo_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_fill_16"
                    android:tint="@color/widget_accent_bg" />

                <TextView
                    android:id="@+id/fav_undo_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/widget_undo"
                    android:textColor="@color/widget_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fav_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/shortcut_expense">

                <ImageView
                    android:id="@+id/fav_add_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_fill_oval"
                    android:tint="@color/widget_accent" />

                <ImageView
                    android:id="@+id/fav_add_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_add" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/fav_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="8dp"
                android:numColumns="3"
                android:stretchMode="columnWidth"
                android:verticalSpacing="8dp" />

            <TextView
                android:id="@+id/fav_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/widget_favorites_empty"
                android:textColor="@color/widget_subtext"
                android:textSize="14sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
